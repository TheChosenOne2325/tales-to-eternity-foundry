<div class="tte-root {{#if fainted}}is-fainted{{/if}} {{#if dead}}is-dead{{/if}}">

  {{!-- Header --}}
  <header class="tte-header">
    <img class="tte-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="tteEditImage"
         {{#if editable}}data-tooltip="{{localize 'TTE.Edit'}}"{{/if}}>
    <div class="tte-identity">
      <div class="tte-identity-top">
        <input class="tte-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'Name'}}"
               {{#unless editable}}disabled{{/unless}}>
        <label class="tte-badge tte-badge-level">
          <span>{{localize "TTE.Level"}}</span>
          <select name="system.details.level" data-dtype="Number" {{#unless editable}}disabled{{/unless}}>
            {{#each levels}}<option value="{{n}}" {{#if selected}}selected{{/if}}>{{n}}</option>{{/each}}
          </select>
        </label>
        <div class="tte-badge tte-badge-tier">
          <span>{{localize "TTE.Tier"}}</span>
          <strong>{{tier}}</strong>
        </div>
        {{#if editable}}
        <div class="tte-header-tools">
          <button type="button" class="tte-tool tte-tool-rest" data-action="downtime" data-type="rest"
                  data-tooltip="<strong>{{localize 'TTE.Downtime.Rest'}}</strong><br>{{localize 'TTE.Downtime.RestHint'}}">
            <i class="fa-solid fa-bed"></i>
          </button>
          <button type="button" class="tte-tool tte-tool-recover" data-action="downtime" data-type="recover"
                  data-tooltip="<strong>{{localize 'TTE.Downtime.Recover'}}</strong><br>{{localize 'TTE.Downtime.RecoverHint'}}">
            <i class="fa-solid fa-campground"></i>
          </button>
          <button type="button" class="tte-tool tte-tool-edit {{#if editMode}}active{{/if}}" data-action="toggleEditMode"
                  data-tooltip="{{#if editMode}}{{localize 'TTE.EditMode.Off'}}{{else}}{{localize 'TTE.EditMode.On'}}{{/if}}">
            <i class="fa-solid {{#if editMode}}fa-lock-open{{else}}fa-pen{{/if}}"></i>
          </button>
        </div>
        {{/if}}
      </div>
      <div class="tte-identity-row">
        {{#if race}}
        <a class="tte-race-pill" data-item-id="{{race.id}}" data-action="itemEdit" data-tooltip="{{localize 'TYPES.Item.race'}}">
          <i class="fa-solid fa-users"></i> {{race.name}}
        </a>
        {{else}}
        <a class="tte-race-pill is-empty" data-action="raceBrowse" data-tooltip="{{localize 'TTE.Race.DropHint'}}">
          <i class="fa-solid fa-users"></i> {{localize "TTE.Race.Choose"}}
        </a>
        {{/if}}
        {{#if classItem}}
        <a class="tte-race-pill tte-class-pill" data-item-id="{{classItem.id}}" data-action="itemEdit" data-tooltip="{{localize 'TTE.ClassLabel'}}">
          <i class="fa-solid fa-shield-halved"></i> {{classItem.name}}
        </a>
        {{else}}
        <a class="tte-race-pill is-empty" data-action="raceBrowse" data-pack="classes" data-tooltip="{{localize 'TTE.Class.DropHint'}}">
          <i class="fa-solid fa-shield-halved"></i> {{localize "TTE.ClassLabel"}}
        </a>
        {{/if}}
        {{#if specItem}}
        <a class="tte-race-pill tte-spec-pill" data-item-id="{{specItem.id}}" data-action="itemEdit" data-tooltip="{{localize 'TTE.Specialization'}}">
          <i class="fa-solid fa-code-branch"></i> {{specItem.name}}
        </a>
        {{else}}{{#if specAvailable}}
        <a class="tte-race-pill is-empty" data-action="raceBrowse" data-pack="classes" data-tooltip="{{localize 'TTE.Class.SpecHint'}}">
          <i class="fa-solid fa-code-branch"></i> {{localize "TTE.Specialization"}}
        </a>
        {{/if}}{{/if}}
        {{#if editable}}
        <a class="tte-race-pill tte-creator-pill {{#unless isBlank}}is-compact{{/unless}}" data-action="openCreator"
           data-tooltip="{{localize 'TTE.Creator.Open'}}">
          <i class="fa-solid fa-hat-wizard"></i>{{#if isBlank}} {{localize "TTE.Creator.Open"}}{{/if}}
        </a>
        {{/if}}
      </div>
    </div>
  </header>

  {{!-- Vitals --}}
  <div class="tte-vitals">
    <div class="tte-vital tte-life {{#if life.low}}is-low{{/if}}">
      <div class="tte-vital-line">
        <span class="tte-mini-label"><i class="fa-solid fa-heart"></i> {{localize "TTE.Life"}}</span>
        <span class="tte-vital-values">
          <input class="tte-life-value" type="number" name="system.life.value" value="{{life.value}}" min="0"
                 max="{{life.max}}" {{#unless editable}}disabled{{/unless}}>
          <span>/ {{life.max}}</span>
        </span>
        {{#if editMode}}{{#unless lifeFromClass}}
        <select class="tte-life-category" name="system.life.category" data-tooltip="{{localize 'TTE.LifeCategoryLabel'}}">
          {{selectOptions lifeCategoryOptions selected=system.life.category localize=true}}
        </select>
        {{/unless}}{{/if}}
      </div>
      <div class="tte-bar tte-bar-life"><div style="width: {{life.pct}}%"></div></div>
    </div>

    <div class="tte-vital tte-wounds">
      <span class="tte-mini-label">{{localize "TTE.Wounds"}}</span>
      <div class="tte-pips tte-pips-wounds">
        {{#each wounds}}
        <button type="button" class="tte-pip {{#if filled}}filled{{/if}} {{#if death}}is-death{{/if}}" data-action="setWounds" data-n="{{n}}"
                data-tooltip="{{tooltip}}"><i class="fa-solid {{#if death}}fa-skull{{else}}fa-droplet{{/if}}"></i></button>
        {{/each}}
      </div>
      {{#if fainted}}{{#unless dead}}{{#if editable}}
      <button type="button" class="tte-chip tte-chip-recovery" data-action="recovery" data-tooltip="{{localize 'TTE.Recovery'}} (DC 11)">
        <i class="fa-solid fa-dice-d20"></i> {{localize "TTE.RecoveryShort"}}
      </button>
      {{/if}}{{/unless}}{{/if}}
    </div>

    <div class="tte-vital tte-stat" data-tooltip="{{localize 'TTE.DefenseHint'}}">
      <span class="tte-mini-label"><i class="fa-solid fa-shield-halved"></i> {{localize "TTE.Defense"}}</span>
      <div class="tte-stat-line">
        <strong>{{defense}}</strong>
        {{#if armorName}}<span class="tte-stat-note">{{armorName}}</span>{{/if}}
      </div>
    </div>

    <div class="tte-vital tte-stat" data-tooltip="{{localize 'TTE.SpeedHint'}}">
      <span class="tte-mini-label"><i class="fa-solid fa-person-running"></i> {{localize "TTE.Speed"}}</span>
      <div class="tte-stat-line">
        {{#if editMode}}
        {{#if speedReduced}}<strong class="is-reduced">{{movement}}</strong><span>/</span>{{/if}}
        <input type="number" name="system.speed" value="{{system.speed}}" min="0">
        {{else}}
        <strong class="{{#if speedReduced}}is-reduced{{/if}}">{{movement}}</strong>
        {{#each speeds}}{{#if value}}<span class="tte-stat-note" data-tooltip="{{label}}"><i class="fa-solid {{icon}}"></i> {{value}}</span>{{/if}}{{/each}}
        {{/if}}
      </div>
    </div>

    <div class="tte-vital tte-xp {{#if xp.ready}}is-ready{{/if}}">
      <div class="tte-vital-line">
        <span class="tte-mini-label"><i class="fa-solid fa-star"></i> {{localize "TTE.XP"}}</span>
        <span class="tte-vital-values">
          {{#if xp.next}}
          <input type="number" name="system.details.xp" value="{{system.details.xp}}" min="0" max="{{xp.next}}"
                 {{#unless editable}}disabled{{/unless}}>
          <span>/ {{xp.next}}</span>
          {{else}}<span>{{localize "TTE.XPMax"}}</span>{{/if}}
        </span>
      </div>
      <div class="tte-bar tte-bar-xp"><div style="width: {{xp.pct}}%"></div></div>
      {{#if levelChoicesPending}}{{#if editable}}
      <button type="button" class="tte-chip tte-chip-levelup" data-action="openLevelUp"><i class="fa-solid fa-list-check"></i> {{localize "TTE.LevelUp.Pending"}}</button>
      {{/if}}{{/if}}
      {{#if xp.ready}}{{#if editable}}
      <button type="button" class="tte-chip tte-chip-levelup" data-action="levelUp"><i class="fa-solid fa-arrow-up"></i> {{localize "TTE.LevelUp.Button"}}</button>
      {{/if}}{{/if}}
    </div>
  </div>

  {{!-- Tabs --}}
  <nav class="tte-tabs">
    {{#each tabs}}
    <button type="button" class="tte-tab-button {{#if active}}active{{/if}}" data-action="tteTab" data-tab="{{id}}">
      <i class="fa-solid {{icon}}"></i> {{label}}
    </button>
    {{/each}}
  </nav>

  <div class="tte-body">

    {{!-- Main tab --}}
    <section class="tte-tab {{#if (eq activeTab 'main')}}active{{/if}}" data-tab="main">

      {{!-- Attributes --}}
      <div class="tte-attributes">
        {{#each attributes}}
        <div class="tte-attribute" data-key="{{key}}">
          {{#if ../editMode}}
          <label class="tte-attribute-edit" data-tooltip="{{label}}: {{hint}}">
            <span class="tte-attribute-abbr">{{abbr}}</span>
            <input type="number" name="system.attributes.{{key}}" value="{{value}}" min="-5" max="5">
          </label>
          {{else}}
          <button type="button" class="tte-attribute-roll" data-action="rollAttribute" data-key="{{key}}"
                  data-tooltip="{{label}}: {{hint}} ({{localize 'TTE.Roll.QuickHint'}})">
            <span class="tte-attribute-abbr">{{abbr}}</span>
            <span class="tte-attribute-mod">{{signed}}</span>
          </button>
          {{/if}}
        </div>
        {{/each}}
      </div>

      {{!-- Skills --}}
      <section class="tte-panel tte-skills">
        <h3 class="tte-panel-title">
          <i class="fa-solid fa-scroll"></i> {{localize "TTE.Skills"}}
          <span class="tte-panel-note">{{localize "TTE.Tier"}} {{tier}} · {{rankLimitLabel}}</span>
          <span class="tte-panel-stat" data-tooltip="{{localize 'TTE.PassivePerceptionHint'}}">
            <i class="fa-solid fa-eye"></i> {{localize "TTE.PassivePerception"}} <strong>{{passivePerception}}</strong>
          </span>
          <button type="button" class="tte-chip tte-chip-flat" data-action="rollFlat"
                  data-tooltip="d20 ({{localize 'TTE.Roll.QuickHint'}})">
            <i class="fa-solid fa-dice-d20"></i> {{localize "TTE.FlatTest"}}
          </button>
        </h3>
        <ol class="tte-skill-list">
          {{#each skills}}
          <li class="tte-skill {{#if trained}}is-trained{{/if}}" data-key="{{key}}">
            <button type="button" class="tte-skill-roll" data-action="rollSkill"
                    data-tooltip="{{hint}} ({{localize 'TTE.Roll.QuickHint'}})">
              <i class="fa-solid fa-dice-d20"></i>
              <span class="tte-skill-name">{{label}}</span>
            </button>
            <div class="tte-pips tte-pips-rank" data-tooltip="{{rankLabel}}">
              {{#each pips}}
              <button type="button" class="tte-pip {{#if filled}}filled{{/if}} {{#if locked}}locked{{/if}}"
                      data-action="setRank" data-n="{{n}}" data-tooltip="{{tooltip}}"></button>
              {{/each}}
            </div>
            <span class="tte-skill-mod">{{signed}}</span>
          </li>
          {{/each}}
        </ol>
      </section>

      {{!-- Traits: only what the character has; everything in edit mode --}}
      {{#if editMode}}
      <div class="tte-bottom-row">
        <section class="tte-panel tte-senses">
          <span class="tte-mini-label"><i class="fa-solid fa-eye"></i> {{localize "TTE.Senses"}}</span>
          <div class="tte-senses-row">
            {{#each senses}}
            <label class="tte-sense" data-tooltip="{{hint}}">
              <span>{{label}}</span>
              <input type="number" name="system.senses.{{key}}" value="{{value}}" min="0">
            </label>
            {{/each}}
          </div>
        </section>

        <section class="tte-panel tte-senses">
          <span class="tte-mini-label"><i class="fa-solid fa-person-swimming"></i> {{localize "TTE.Speeds"}}</span>
          <div class="tte-senses-row">
            {{#each speeds}}
            <label class="tte-sense" data-tooltip="{{hint}}">
              <span>{{label}}</span>
              <input type="number" name="system.speeds.{{key}}" value="{{value}}" min="0">
            </label>
            {{/each}}
          </div>
        </section>

        <section class="tte-panel tte-traits">
          <div class="tte-traits-size">
            <label class="tte-trait" data-tooltip="{{localize 'TTE.Size.Hint'}}">
              <span class="tte-mini-label"><i class="fa-solid fa-up-right-and-down-left-from-center"></i> {{localize "TTE.Size.Label"}}</span>
              <select name="system.size">
                {{selectOptions sizeOptions selected=system.size localize=true}}
              </select>
            </label>
            <div class="tte-trait" data-tooltip="{{localize 'TTE.ReachHint'}}">
              <span class="tte-mini-label"><i class="fa-solid fa-arrows-left-right"></i> {{localize "TTE.Reach"}}</span>
              <strong>{{reach}}</strong>
            </div>
          </div>
          <div class="tte-traits-languages">
            <span class="tte-mini-label"><i class="fa-solid fa-language"></i> {{localize "TTE.Languages"}}</span>
            <div class="tte-chips">
              {{#each languages}}
              <button type="button" class="tte-chip {{#if active}}active{{/if}}" data-action="toggleLanguage" data-language="{{key}}"
                      data-tooltip="{{hint}}">{{label}}</button>
              {{/each}}
              <input type="text" class="tte-language-custom" name="system.languages.custom" value="{{system.languages.custom}}"
                     placeholder="{{localize 'TTE.LanguagesOther'}}">
            </div>
          </div>
        </section>
      </div>
      {{else}}
      <section class="tte-panel tte-traits-view">
        <span class="tte-trait-item" data-tooltip="{{localize 'TTE.Size.Hint'}}">
          <i class="fa-solid fa-up-right-and-down-left-from-center"></i> <small>{{localize "TTE.Size.Label"}}</small> <strong>{{sizeLabel}}</strong>
        </span>
        <span class="tte-trait-item" data-tooltip="{{localize 'TTE.ReachHint'}}">
          <i class="fa-solid fa-arrows-left-right"></i> <small>{{localize "TTE.Reach"}}</small> <strong>{{reach}}</strong>
        </span>
        {{#each senses}}{{#if value}}
        <span class="tte-trait-item" data-tooltip="{{hint}}">
          <i class="fa-solid fa-eye"></i> <small>{{label}}</small> <strong>{{value}}</strong>
        </span>
        {{/if}}{{/each}}
        {{#if languageList}}
        <span class="tte-trait-item tte-trait-languages">
          <i class="fa-solid fa-language"></i> <small>{{localize "TTE.Languages"}}</small> <strong>{{languageList}}</strong>
        </span>
        {{/if}}
      </section>
      {{/if}}
    </section>

    {{!-- Spells tab --}}
    {{#if spells.show}}
    <section class="tte-tab {{#if (eq activeTab 'spells')}}active{{/if}}" data-tab="spells">
      <div class="tte-inventory-bar tte-spell-bar">
        <span class="tte-panel-stat tte-stat-mana" data-tooltip="{{localize 'TTE.Spell.ManaHint'}}">
          <i class="fa-solid fa-droplet"></i> {{localize "TTE.Mana"}}
          <input class="tte-mana-input" type="number" name="system.mana.value" value="{{mana.value}}" min="0" max="{{mana.max}}" {{#unless editable}}disabled{{/unless}}>
          <strong>/ {{mana.max}}</strong>
        </span>
        <span class="tte-panel-stat" data-tooltip="{{localize 'TTE.Spell.AttackHint'}}">
          <i class="fa-solid fa-crosshairs"></i> {{localize "TTE.Spell.AttackLabel"}} <strong>{{spells.attack}}</strong>
        </span>
        <span class="tte-panel-stat" data-tooltip="{{localize 'TTE.Spell.DCHint'}}">
          <i class="fa-solid fa-bullseye"></i> {{localize "TTE.Spell.DC"}} <strong>{{spells.dc}}</strong>
        </span>
        {{#if spells.conjuring}}<span class="tte-panel-stat"><i class="fa-solid fa-brain"></i> {{spells.conjuring}}</span>{{/if}}
        {{#if spells.max}}
        <span class="tte-panel-stat {{#if spells.over}}is-over{{/if}}" data-tooltip="{{localize 'TTE.Spell.KnownHint'}}">
          <i class="fa-solid fa-book"></i> {{localize "TTE.Spell.Known"}} <strong>{{spells.count}} / {{spells.max}}</strong>
        </span>
        {{/if}}
      </div>
      {{#each spells.groups}}
      <section class="tte-panel {{#if collapsed}}is-collapsed{{/if}}" data-section-key="{{key}}">
        <h3 class="tte-panel-title" data-action="toggleSection"><i class="fa-solid fa-wand-sparkles"></i> {{label}} <i class="fa-solid fa-chevron-down tte-collapse-icon"></i></h3>
        <ol class="tte-item-list tte-inventory-list">
          {{#each spells}}
          <li class="tte-item-row" data-item-id="{{id}}">
            <a class="tte-use" data-action="itemUse" data-tooltip="{{localize 'TTE.Spell.Conjure'}}"><img src="{{img}}" alt=""><i class="fa-solid fa-wand-sparkles"></i></a>
            <div class="tte-item-main">
              <a class="tte-item-name" data-action="itemEdit">{{name}}</a>
              <span class="tte-item-sub">
                <span class="tte-school tte-school-{{schoolClass}}">{{school}}</span>
                {{#if range}}<span>{{range}}</span>{{/if}}
                {{#if concentration}}<span class="tte-conc"><i class="fa-solid fa-eye"></i> {{localize "TTE.Condition.concentrating"}}</span>{{else}}<span>{{duration}}</span>{{/if}}
                {{#if components}}<span>{{components}}</span>{{/if}}
                {{#if trigger}}<span class="tte-item-props">{{trigger}}</span>{{/if}}
              </span>
            </div>
            {{#if roll}}<span class="tte-item-meta">{{roll}}</span>{{/if}}
            {{#if effect}}<span class="tte-item-meta tte-spell-effect">{{effect}}</span>{{/if}}
            <div class="tte-item-controls">
              <a data-action="itemChat" data-tooltip="{{localize 'TTE.PostToChat'}}"><i class="fa-solid fa-comment"></i></a>
              {{#if @root.editable}}
              <a data-action="itemEdit" data-tooltip="{{localize 'TTE.Edit'}}"><i class="fa-solid fa-pen"></i></a>
              <a data-action="itemDelete" data-tooltip="{{localize 'TTE.Delete'}}"><i class="fa-solid fa-trash"></i></a>
              {{/if}}
            </div>
          </li>
          {{/each}}
        </ol>
      </section>
      {{else}}
      <section class="tte-panel"><p class="tte-empty">{{localize "TTE.Spell.Empty"}}</p></section>
      {{/each}}
      {{#if editable}}
      <div class="tte-spell-actions">
        <button type="button" class="tte-button" data-action="raceBrowse" data-pack="spells"><i class="fa-solid fa-book-open"></i> {{localize "TTE.Spell.Browse"}}</button>
        <button type="button" class="tte-button" data-action="itemCreate" data-type="spell"><i class="fa-solid fa-plus"></i> {{localize "TTE.Create"}}</button>
      </div>
      {{/if}}
    </section>
    {{/if}}

    {{!-- Effects tab --}}
    <section class="tte-tab {{#if (eq activeTab 'effects')}}active{{/if}}" data-tab="effects">
      <section class="tte-band {{#if (lookup @root.collapsed 'eff-passive')}}is-collapsed{{/if}}" data-section-key="eff-passive">
        <h3 class="tte-band-title" data-action="toggleSection">
          {{localize "TTE.Effects.Passive"}}
          {{#if editable}}
          <button type="button" class="tte-band-button" data-action="effectCreate" data-tooltip="{{localize 'TTE.Effects.New'}}">
            <i class="fa-solid fa-plus"></i>
          </button>
          {{/if}}
        <i class="fa-solid fa-chevron-down tte-collapse-icon"></i></h3>
        {{#if passiveEffects.length}}
        <ol class="tte-effect-list">
          {{#each passiveEffects}}
          <li class="tte-effect {{#if disabled}}is-disabled{{/if}}" data-effect-uuid="{{uuid}}">
            <img src="{{img}}" alt="" data-action="effectEdit">
            <a class="tte-effect-name" data-action="effectEdit">{{name}}</a>
            <span class="tte-item-meta">{{source}}</span>
            <span class="tte-item-meta">{{#if duration}}{{duration}}{{else}}—{{/if}}</span>
            <button type="button" class="tte-switch {{#unless disabled}}on{{/unless}}" data-action="effectToggle"
                    data-tooltip="{{localize 'TTE.Effects.Toggle'}}" {{#unless ../editable}}disabled{{/unless}}></button>
            <div class="tte-item-controls">
              <a data-action="effectEdit" data-tooltip="{{localize 'TTE.Edit'}}"><i class="fa-solid fa-pen"></i></a>
              {{#if ../editable}}
              <a data-action="effectDelete" data-tooltip="{{localize 'TTE.Delete'}}"><i class="fa-solid fa-trash"></i></a>
              {{/if}}
            </div>
          </li>
          {{/each}}
        </ol>
        {{else}}
        <p class="tte-empty">{{localize "TTE.Effects.Empty"}}</p>
        {{/if}}
      </section>

      <section class="tte-band {{#if (lookup @root.collapsed 'eff-conditions')}}is-collapsed{{/if}}" data-section-key="eff-conditions">
        <h3 class="tte-band-title" data-action="toggleSection">{{localize "TTE.Effects.Conditions"}} <i class="fa-solid fa-chevron-down tte-collapse-icon"></i></h3>
        <ol class="tte-condition-grid">
          {{#each conditions}}
          <li class="tte-condition {{#if active}}active{{/if}} {{#if implied}}implied{{/if}}" data-condition="{{id}}"
              data-tooltip="{{hint}}">
            <img src="{{img}}" alt="">
            <span class="tte-condition-name">{{label}}</span>
            {{#if levels}}
            <div class="tte-counter">
              <button type="button" data-action="changeDeprived" data-delta="-1" {{#unless ../editable}}disabled{{/unless}}><i class="fa-solid fa-minus"></i></button>
              <strong>{{levels.value}}</strong>
              <button type="button" data-action="changeDeprived" data-delta="1" {{#unless ../editable}}disabled{{/unless}}><i class="fa-solid fa-plus"></i></button>
            </div>
            {{else if automatic}}
            <span class="tte-auto" data-tooltip="{{localize 'TTE.Effects.Auto'}}"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
            {{else}}
            {{#if tier}}{{#if active}}
            <select class="tte-condition-tier" name="{{tier.name}}" data-tooltip="{{localize 'TTE.Effects.Tier'}}"
                    {{#unless ../editable}}disabled{{/unless}}>
              <option value="1" {{#if (eq tier.value 1)}}selected{{/if}}>T1</option>
              <option value="2" {{#if (eq tier.value 2)}}selected{{/if}}>T2</option>
              <option value="3" {{#if (eq tier.value 3)}}selected{{/if}}>T3</option>
              <option value="4" {{#if (eq tier.value 4)}}selected{{/if}}>T4</option>
            </select>
            {{/if}}{{/if}}
            <button type="button" class="tte-switch {{#if active}}on{{/if}} {{#if implied}}implied{{/if}}" data-action="toggleCondition"
                    {{#unless ../editable}}disabled{{/unless}}></button>
            {{/if}}
          </li>
          {{/each}}
        </ol>
      </section>

      <section class="tte-band {{#if (lookup @root.collapsed 'eff-affinities')}}is-collapsed{{/if}}" data-section-key="eff-affinities">
        <h3 class="tte-band-title" data-action="toggleSection">{{localize "TTE.Affinity.Title"}} <i class="fa-solid fa-chevron-down tte-collapse-icon"></i></h3>
        <ol class="tte-affinity-grid">
          {{#each affinities}}
          <li class="tte-affinity {{#if active}}active{{/if}} tte-affinity-{{value}}" data-tooltip="{{hint}}">
            <span>{{label}}</span>
            <select name="system.affinities.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
              {{selectOptions ../affinityOptions selected=value localize=true}}
            </select>
          </li>
          {{/each}}
        </ol>
      </section>
    </section>

    {{!-- Features tab --}}
    <section class="tte-tab {{#if (eq activeTab 'features')}}active{{/if}}" data-tab="features">
      {{#if showResource}}
      <section class="tte-panel tte-resource">
        <span class="tte-mini-label"><i class="fa-solid fa-gem"></i> {{localize "TTE.Resource"}}</span>
        <div class="tte-resource-row">
          {{#if editMode}}
          <input type="text" name="system.resource.label" value="{{system.resource.label}}"
                 placeholder="{{localize 'TTE.ResourceName'}}" {{#if resourceFromClass}}disabled{{/if}}>
          {{else}}<strong class="tte-resource-name">{{system.resource.label}}</strong>{{/if}}
          <div class="tte-resource-values">
            <input type="number" name="system.resource.value" value="{{system.resource.value}}" min="0" {{#unless editable}}disabled{{/unless}}>
            <span>/</span>
            {{#if editMode}}{{#unless resourceFromClass}}
            <input type="number" name="system.resource.max" value="{{system.resource.max}}" min="0">
            {{else}}<span>{{system.resource.max}}</span>{{/unless}}{{else}}<span>{{system.resource.max}}</span>{{/if}}
          </div>
        </div>
      </section>
      {{/if}}
      {{#each featureGroups}}
      <section class="tte-panel tte-feature-group {{#if collapsed}}is-collapsed{{/if}}" data-section-key="{{key}}">
        <h3 class="tte-panel-title" data-action="toggleSection">
          <i class="fa-solid {{icon}}"></i> {{label}}
          {{#if origin}}<span class="tte-feature-origin">· {{origin}}</span>{{/if}}
          {{#if @root.editable}}
          <a class="tte-feature-add" data-action="itemCreate" data-type="feature" data-feature-type="{{type}}"
             data-tooltip="{{localize 'TTE.Create'}}"><i class="fa-solid fa-plus"></i></a>
          {{/if}}
          <i class="fa-solid fa-chevron-down tte-collapse-icon"></i>
        </h3>
        {{#if features.length}}
        <ol class="tte-item-list">
          {{#each features}}
          <li class="tte-item-row" data-item-id="{{item.id}}">
            <img src="{{item.img}}" alt="" data-action="itemEdit">
            <a class="tte-item-name" data-action="itemEdit">{{item.name}}</a>
            {{#if uses}}
            <span class="tte-uses" data-tooltip="{{localize 'TTE.Uses.Hint'}}">
              <a data-action="featureRestore" data-tooltip="{{localize 'TTE.Uses.Restore'}}"><i class="fa-solid fa-rotate-left"></i></a>
              <strong>{{uses.value}}/{{uses.max}}</strong> <span>{{uses.per}}</span>
              <a data-action="featureSpend" data-tooltip="{{localize 'TTE.Uses.Use'}}"><i class="fa-solid fa-bolt"></i></a>
            </span>
            {{else if usable}}
            <span class="tte-uses">
              <a data-action="featureSpend" data-tooltip="{{localize 'TTE.Uses.Use'}}"><i class="fa-solid fa-bolt"></i></a>
            </span>
            {{/if}}
            <span class="tte-item-meta">{{#if marked}}<i class="fa-solid fa-crosshairs"></i> {{marked}}{{else}}{{meta}}{{/if}}</span>
            <span class="tte-item-meta tte-source">{{item.system.source}}</span>
            <div class="tte-item-controls">
              <a data-action="itemChat" data-tooltip="{{localize 'TTE.PostToChat'}}"><i class="fa-solid fa-comment"></i></a>
              {{#if @root.editable}}
              <a data-action="itemEdit" data-tooltip="{{localize 'TTE.Edit'}}"><i class="fa-solid fa-pen"></i></a>
              <a data-action="itemDelete" data-tooltip="{{localize 'TTE.Delete'}}"><i class="fa-solid fa-trash"></i></a>
              {{/if}}
            </div>
          </li>
          {{/each}}
        </ol>
        {{else}}
        <p class="tte-empty">{{localize "TTE.Feature.Empty"}}</p>
        {{/if}}
      </section>
      {{else}}
      <p class="tte-empty">{{localize "TTE.Feature.Empty"}}</p>
      {{/each}}
    </section>

    {{!-- Inventory tab --}}
    <section class="tte-tab {{#if (eq activeTab 'inventory')}}active{{/if}}" data-tab="inventory">
      <label class="tte-search-box">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input class="tte-search" type="search" placeholder="{{localize 'TTE.Inventory.Search'}}" autocomplete="off">
      </label>
      <div class="tte-inventory-bar">
        <div class="tte-quick">
          <button type="button" class="tte-quick-button" data-action="unarmedAttack"
                  data-tooltip="{{@root.unarmed.label}}: {{@root.unarmed.damage}}">
            <i class="fa-solid fa-hand-fist"></i> {{localize "TTE.Inventory.Unarmed"}}
          </button>
          {{#each containers}}
          <button type="button" class="tte-quick-button tte-container-chip {{#if open}}is-open{{/if}} {{#if equipped}}is-worn{{/if}}"
                  data-action="containerOpen" data-container-id="{{id}}" data-item-id="{{id}}"
                  data-tooltip="{{localize 'TTE.Inventory.ContainerHint'}}">
            <img src="{{img}}" alt=""> {{name}} {{#if count}}<span class="tte-chip-count">{{count}}</span>{{/if}}
          </button>
          {{/each}}
          {{#if editable}}
          <button type="button" class="tte-quick-button tte-quick-add" data-action="itemCreate" data-type="container"
                  data-tooltip="{{localize 'TTE.Inventory.NewContainer'}}"><i class="fa-solid fa-plus"></i></button>
          {{/if}}
        </div>
        <span class="tte-panel-stat {{#if load.over}}is-over{{/if}}" data-tooltip="{{localize 'TTE.LoadHint'}}">
          <i class="fa-solid fa-weight-hanging"></i> {{localize "TTE.Load"}} <strong>{{load.value}} / {{load.max}}</strong>
        </span>
        <label class="tte-currency" data-tooltip="{{localize 'TTE.CurrencyHint'}}">
          <i class="fa-solid fa-coins"></i> {{localize "TTE.Currency"}}
          <input type="number" name="system.currency" value="{{system.currency}}" min="0" {{#unless editable}}disabled{{/unless}}>
        </label>
      </div>
      {{#each inventory}}
      {{#if panel}}
      <section class="tte-panel tte-inventory-section tte-container-panel" data-section="{{id}}" data-container-id="{{containerId}}" data-item-id="{{containerId}}">
        <h3 class="tte-panel-title">
          <img src="{{img}}" alt=""> {{label}}
          {{#if capacity}}<span class="tte-item-meta tte-capacity {{#if over}}is-over{{/if}}" data-tooltip="{{localize 'TTE.Container.Capacity'}}">{{capacity}}</span>{{/if}}
          {{#if detail}}<span class="tte-item-meta">{{detail}}</span>{{/if}}
          <div class="tte-item-controls">
            <a data-action="itemCarry" class="{{#if carried}}active{{/if}}" data-tooltip="{{localize 'TTE.Container.Carried'}}"><i class="fa-solid fa-person-walking-luggage"></i></a>
            {{#if equippable}}<a data-action="itemEquip" class="{{#if equipped}}active{{/if}}" data-tooltip="{{localize 'TTE.Item.Equipped'}}"><i class="fa-solid fa-shirt"></i></a>{{/if}}
            <a data-action="itemChat" data-tooltip="{{localize 'TTE.PostToChat'}}"><i class="fa-solid fa-comment"></i></a>
            {{#if @root.editable}}
            <a data-action="itemEdit" data-tooltip="{{localize 'TTE.Edit'}}"><i class="fa-solid fa-pen"></i></a>
            <a data-action="itemDelete" data-tooltip="{{localize 'TTE.Delete'}}"><i class="fa-solid fa-trash"></i></a>
            {{/if}}
            <a data-action="containerOpen" data-tooltip="{{localize 'TTE.Inventory.Close'}}"><i class="fa-solid fa-xmark"></i></a>
          </div>
        </h3>
      {{else}}
      <section class="tte-panel tte-inventory-section {{#if collapsed}}is-collapsed{{/if}}" data-section="{{id}}" data-section-key="{{key}}">
        <h3 class="tte-panel-title" data-action="toggleSection">
          <i class="fa-solid {{icon}}"></i> {{label}}
          {{#if create}}{{#if @root.editable}}
          <a class="tte-feature-add" data-action="itemCreate" data-type="{{id}}" data-tooltip="{{localize 'TTE.Create'}}"><i class="fa-solid fa-plus"></i></a>
          {{/if}}{{/if}}
          <i class="fa-solid fa-chevron-down tte-collapse-icon"></i>
        </h3>
      {{/if}}
        <ol class="tte-item-list tte-inventory-list">
          {{#each items}}
          <li class="tte-item-row {{#if isContainer}}tte-container-row{{/if}} {{#if equipped}}is-equipped{{/if}}"
              data-item-id="{{id}}" {{#if isContainer}}data-container-id="{{id}}"{{/if}} style="--depth: {{depth}}">
            {{#if isContainer}}
            <a class="tte-expand" data-action="containerToggle"><i class="fa-solid {{#if expanded}}fa-caret-down{{else}}fa-caret-right{{/if}}"></i></a>
            {{/if}}
            {{#if usable}}
            <a class="tte-use" data-action="itemUse" data-tooltip="{{useLabel}}"><img src="{{img}}" alt=""><i class="fa-solid {{useIcon}}"></i></a>
            {{else}}
            <img src="{{img}}" alt="" data-action="itemEdit">
            {{/if}}
            <div class="tte-item-main">
              <a class="tte-item-name" data-action="itemEdit">{{name}}</a>
              <span class="tte-item-sub">
                {{#if category}}<span>{{category}}</span>{{/if}}
                {{#if detail}}<span>{{detail}}</span>{{/if}}
                {{#if properties}}<span class="tte-item-props">{{properties}}</span>{{/if}}
              </span>
            </div>
            {{#if capacity}}<span class="tte-item-meta tte-capacity {{#if over}}is-over{{/if}}" data-tooltip="{{localize 'TTE.Container.Capacity'}}">{{capacity}}</span>{{/if}}
            {{#if ammo}}<span class="tte-item-meta tte-ammo" data-tooltip="{{localize 'TTE.Ammo.Hint'}}">{{ammo}}</span>{{/if}}
            <span class="tte-item-meta tte-qty" data-tooltip="{{localize 'TTE.Equipment.Quantity'}}">
              {{#if @root.editable}}<a data-action="itemQuantity" data-delta="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}
              <span>{{quantity}}</span>
              {{#if @root.editable}}<a data-action="itemQuantity" data-delta="1"><i class="fa-solid fa-plus"></i></a>{{/if}}
            </span>
            <span class="tte-item-meta tte-load" data-tooltip="{{localize 'TTE.Equipment.Load'}}"><i class="fa-solid fa-weight-hanging"></i> {{load}}</span>
            <div class="tte-item-controls">
              {{#if isContainer}}
              <a data-action="itemCarry" class="{{#if carried}}active{{/if}}" data-tooltip="{{localize 'TTE.Container.Carried'}}"><i class="fa-solid fa-person-walking-luggage"></i></a>
              {{/if}}
              {{#if equippable}}
              <a data-action="itemEquip" class="{{#if equipped}}active{{/if}}" data-tooltip="{{localize 'TTE.Item.Equipped'}}"><i class="fa-solid fa-shirt"></i></a>
              {{/if}}
              {{#if @root.hasContainers}}{{#if @root.editable}}
              <a data-action="itemMove" class="{{#if inContainer}}active{{/if}}" data-tooltip="{{localize 'TTE.Container.Move'}}"><i class="fa-solid fa-box-open"></i></a>
              {{/if}}{{/if}}
              <a data-action="itemChat" data-tooltip="{{localize 'TTE.PostToChat'}}"><i class="fa-solid fa-comment"></i></a>
              {{#if @root.editable}}
              <a data-action="itemEdit" data-tooltip="{{localize 'TTE.Edit'}}"><i class="fa-solid fa-pen"></i></a>
              <a data-action="itemDelete" data-tooltip="{{localize 'TTE.Delete'}}"><i class="fa-solid fa-trash"></i></a>
              {{/if}}
            </div>
          </li>
          {{/each}}
          {{#unless items.length}}
          <li class="tte-empty">{{#if panel}}{{localize "TTE.Inventory.DropHint"}}{{else}}{{localize "TTE.Inventory.Empty"}}{{/if}}</li>
          {{/unless}}
        </ol>
      </section>
      {{/each}}
    </section>

    {{!-- Biography tab --}}
    <section class="tte-tab {{#if (eq activeTab 'biography')}}active{{/if}}" data-tab="biography">
      <section class="tte-panel tte-profile">
        {{#each profile}}
        <label class="tte-profile-field">
          <span class="tte-mini-label">{{label}}</span>
          <input type="text" name="system.profile.{{key}}" value="{{value}}" {{#unless ../editable}}disabled{{/unless}}>
        </label>
        {{/each}}
      </section>
      <section class="tte-panel tte-editor-panel tte-editor-small">
        <h3 class="tte-panel-title"><i class="fa-solid fa-user-pen"></i> {{localize "TTE.Profile.Description"}}</h3>
        {{#if editable}}
        <prose-mirror name="system.appearance" value="{{source.appearance}}" document-uuid="{{actor.uuid}}"></prose-mirror>
        {{else}}
        <div class="editor"><div class="editor-content">{{{enrichedAppearance}}}</div></div>
        {{/if}}
      </section>
      <section class="tte-panel tte-editor-panel">
        <h3 class="tte-panel-title"><i class="fa-solid fa-feather"></i> {{localize "TTE.Profile.History"}}</h3>
        {{#if editable}}
        <prose-mirror name="system.biography" value="{{source.biography}}" document-uuid="{{actor.uuid}}"></prose-mirror>
        {{else}}
        <div class="editor"><div class="editor-content">{{{enrichedBiography}}}</div></div>
        {{/if}}
      </section>
    </section>

  </div>
</div>
